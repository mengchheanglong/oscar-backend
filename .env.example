# ==============================================================================
# Continuum Backend - Environment Configuration Template
# Copy to .env for local development. Never commit real credentials.
# ==============================================================================

# Server & Network
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3002
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Database (Local Docker or Supabase Cloud Pooler)
# Local:    postgresql://ai_workspace:local_dev_only@127.0.0.1:55432/ai_workspace_develop
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://ai_workspace:local_dev_only@127.0.0.1:55432/ai_workspace_develop

# Test Database (Dedicated for pnpm test:integration; never point tests at dev DB)
TEST_DATABASE_URL=postgresql://ai_workspace_test:local_test_only@127.0.0.1:55433/ai_workspace_test

# Redis (Local Docker, Render Key-Value, or Upstash TLS)
# Local:   redis://127.0.0.1:56379
# Render:  redis://red-[id]:6379
# Upstash: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL=redis://127.0.0.1:56379

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/uploads
MAX_UPLOAD_BYTES=20971520

# Session Configuration
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7

# Initial Admin Bootstrap (Optional; created on first boot if no admin exists)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Supabase Credentials (Optional for local; required when using Supabase Auth/Storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# AI Configuration (DeepSeek LLM + Mock or OpenAI Embeddings)
AI_ENABLED=false
# Optional Hermes subprocess; see docs/HERMES_RUNTIME.md. Keep disabled until prepared.
HERMES_ENABLED=false
HERMES_PYTHON=
HERMES_ROOT=
AI_LLM_PROVIDER=deepseek
# Conservative byte-based input budget; not an exact tokenizer count.
AI_CONTEXT_INPUT_BUDGET=128000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-flash
AI_EMBEDDING_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Calibrate on a representative recall evaluation when changing embedding models.
AI_HISTORY_MAX_COSINE_DISTANCE=0.65
# Optional background history indexing. UTC-day limits count reserved input, including retries.
# Separate from generation's USD budget; zero pauses that allowance. No batch model suffix.
AI_HISTORY_AUTO_INDEX_ENABLED=false
AI_HISTORY_INDEX_DAILY_TEXTS=256
AI_HISTORY_INDEX_DAILY_BYTES=512000
AI_HISTORY_INDEX_SCOPE_DAILY_TEXTS=64
AI_HISTORY_INDEX_SCOPE_DAILY_BYTES=128000
AI_DAILY_PROJECT_BUDGET_USD=10

# GitHub Integration (Optional)
GITHUB_ENABLED=false
GITHUB_USE_MOCK=false

# Local-only read access to explicitly connected folders; requires loopback HOST.
LOCAL_FILES_ENABLED=false
LOCAL_FILES_REGISTRY=./var/local-folders.json

# Uploaded folder originals: per-account quota across projects; no per-folder byte cap.
FOLDER_STORAGE_QUOTA_BYTES=21474836480
FOLDER_MAX_FILE_BYTES=1073741824
FOLDER_MAX_FILES=100000
FOLDER_MAX_SOURCES=100
