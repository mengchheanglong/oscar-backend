{
  "name": "continuum-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Continuum API, project knowledge, and agent runtime",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.cjs --selectProjects unit --runInBand",
    "test:e2e": "jest --config jest.config.cjs --selectProjects e2e --runInBand",
    "test:integration": "node scripts/run-integration.cjs",
    "test:ai-eval": "ts-node scripts/run-ai-eval.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "mcp:start": "ts-node scripts/mcp-server.ts",
    "seed": "ts-node scripts/seed.ts",
    "db:test-connection": "ts-node scripts/test-db-connection.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:stop": "docker compose --profile app --profile test stop"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "@supabase/server": "1.8.0",
    "@supabase/supabase-js": "2.117.2",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mammoth": "1.12.3",
    "multer": "2.3.0",
    "nestjs-pino": "5.1.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2"
    ]
  }
}
